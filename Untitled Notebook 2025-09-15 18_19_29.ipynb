   "source": [
    "%sql\n",
    "CREATE OR REPLACE TABLE bronze_sales AS\n",
    "SELECT * FROM my_catalog.my_db1.sales_fact;\n",
    "\n",
    "CREATE OR REPLACE TABLE silver_sales AS\n",
    "SELECT\n",
    "  sales_id,\n",
    "  date_id,\n",
    "  product_id,\n",
    "  customer_id,\n",
    "  quantity,\n",
    "  total_amount\n",
    "FROM bronze_sales\n",
    "WHERE quantity > 0 AND total_amount > 0;"
   ]
